{
    "version": "0.4.490",
    "description": "GUI client for herdr: Claude Code, Codex and pi agent sessions as clean chats.",
    "homepage": "https://alma.now",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/yetone/alma-releases/releases/download/v0.4.490/alma-0.4.490-win-x64.exe#/dl.7z",
            "hash": "sha512:0e915f6ca5881afc6abb54c96e874e9451d646941682c68c5ea4c2f643983ba225ef4a366f4c74e2a1b9400e00ff65016e685ed3e2a51e0740c78999bd0f9801",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Recurse"
            ]
        }
    },
    "persist_external": [
        [
            "$env:AppData\\alma",
            "data",
            "directory"
        ],
        [
            "$env:USERPROFILE\\.config\\alma",
            "config",
            "directory"
        ],
        [
            "$env:USERPROFILE\\.alma",
            "activity",
            "directory"
        ],
        [
            "$env:USERPROFILE\\.cache\\alma",
            "cache",
            "directory"
        ]
    ],
    "post_install": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "shortcuts": [
        [
            "Alma.exe",
            "Alma"
        ]
    ],
    "checkver": {
        "github": "https://github.com/yetone/alma-releases"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yetone/alma-releases/releases/download/v$version/alma-$version-win-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "$basename\\s+sha512:\\s+$base64"
        }
    }
}
