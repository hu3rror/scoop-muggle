{
    "version": "3.7.6",
    "description": "GUI for rclone & S3",
    "homepage": "https://rcloneui.com",
    "license": "Apache-2.0",
    "suggest": {
        "Microsoft Edge WebView2": "extras/webview2"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/rclone-ui/rclone-ui/releases/download/v3.7.6/Rclone.UI_x64.exe#/dl.7z",
            "hash": "da521e4b35d8100a7b5396d36062ca3bc7b4dea371c2bce8b5cec8e97096bf7e"
        },
        "arm64": {
            "url": "https://github.com/rclone-ui/rclone-ui/releases/download/v3.7.6/Rclone.UI_arm64.exe#/dl.7z",
            "hash": "63d80f5a00e5a73057fbd1b90cc78d6db604d9f37de8fafad38625797bd69552"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\uninstall.exe\" -Force -Recurse",
    "persist_external": [
        [
            "$env:APPDATA\\com.rclone.ui",
            "data",
            "directory"
        ],
        [
            "$env:LOCALAPPDATA\\com.rclone.ui",
            "cache",
            "directory"
        ]
    ],
    "post_install": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "bin": [
        [
            "Rclone UI.exe",
            "rclone-ui"
        ]
    ],
    "shortcuts": [
        [
            "Rclone UI.exe",
            "Rclone UI"
        ]
    ],
    "checkver": {
        "github": "https://github.com/rclone-ui/rclone-ui"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/rclone-ui/rclone-ui/releases/download/v$version/Rclone.UI_x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/rclone-ui/rclone-ui/releases/download/v$version/Rclone.UI_arm64.exe#/dl.7z"
            }
        }
    }
}
